# Polymarket Trading Configuration

# ============================================
# POLYMARKET API (Required for trading)
# ============================================

# Get these from reveal.polymarket.com (for email/Magic wallet)
# Or export from MetaMask (for EOA wallet)
POLYMARKET_PRIVATE_KEY=your-private-key-here
POLYMARKET_FUNDER_ADDRESS=your-proxy-or-wallet-address-here

# Builder code for attribution (optional)
# If not set, will use POLYMARKET_BUILDERS_KEY from main .env
POLYMARKET_BUILDER_CODE=your-builder-code-here

# Enable/disable live trading
# false = predictions only (safe for testing)
# true = real trades with real money
TRADING_ENABLED=false

# ============================================
# TWITTER API (Required for posting)
# ============================================
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-secret
TWITTER_BEARER_TOKEN=your-bearer-token
MAIN_TWITTER_HANDLE=@polydictions

# ============================================
# AI ANALYSIS API (Required)
# ============================================
POLYFACTUAL_API_KEY=your-polyfactual-api-key
POLYFACTUAL_API_URL=https://deep-research-api.thekid-solana.workers.dev/answer

# ============================================
# AGENT SETTINGS
# ============================================
# How often to post (hours)
AGENT_POST_INTERVAL=4

# ============================================
# OPTIONAL: Advanced Settings
# ============================================
# Polymarket network (don't change unless you know what you're doing)
# POLYMARKET_CHAIN_ID=137
# POLYMARKET_HOST=https://clob.polymarket.com

# Database paths
# TRADING_DB_PATH=trading.db
# AGENT_DB_PATH=agent_trading.db

# Risk management (edit in polymarket_trader.py for fine control)
# MAX_POSITION_SIZE_USD=100
# MAX_TOTAL_EXPOSURE_USD=500
# MIN_EDGE_PCT=5.0
