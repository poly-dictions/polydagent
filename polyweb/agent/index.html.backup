<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ai trader - polydictions</title>
    <link rel="icon" type="image/png" href="../images/1.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
    <style>
        /* Additional styles for trader page */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            transition: all 0.1s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
        }

        .stat-label {
            font-size: 12px;
            color: rgba(0, 0, 0, 0.5);
            text-transform: lowercase;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: #fb651e;
        }

        .stat-value.green {
            color: #4ADE80;
        }

        .stat-value.red {
            color: #F87171;
        }

        .positions-section, .history-section {
            margin-bottom: 32px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 16px;
            text-transform: lowercase;
        }

        .trades-table {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 20px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 12px;
            font-size: 12px;
            font-weight: 600;
            text-transform: lowercase;
            color: rgba(0, 0, 0, 0.5);
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        }

        td {
            padding: 12px;
            font-size: 14px;
            color: #1a1a1a;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        tr:hover td {
            background: rgba(251, 101, 30, 0.05);
        }

        .signal-yes {
            color: #4ADE80;
            font-weight: 600;
        }

        .signal-no {
            color: #F87171;
            font-weight: 600;
        }

        .status-open {
            display: inline-flex;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: lowercase;
            background: rgba(251, 191, 36, 0.15);
            color: #d97706;
        }

        .status-closed {
            display: inline-flex;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: lowercase;
            background: rgba(74, 222, 128, 0.15);
            color: #4ADE80;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: rgba(0, 0, 0, 0.5);
            font-size: 14px;
        }

        .inactive-state {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            margin: 40px 0;
        }

        .inactive-state h2 {
            font-size: 24px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 12px;
        }

        .inactive-state p {
            font-size: 16px;
            color: rgba(0, 0, 0, 0.6);
            margin-bottom: 24px;
        }

        .inactive-state code {
            display: inline-block;
            background: rgba(251, 101, 30, 0.1);
            padding: 8px 16px;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            color: #fb651e;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: rgba(255, 255, 255, 0.7);
        }

        .spinner {
            width: 32px;
            height: 32px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 16px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <a href="/" class="navbar-logo">polydictions</a>
        <div class="navbar-links">
            <a href="/" class="navbar-link" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">home</a>
            <a href="/markets/" class="navbar-link" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">markets</a>
            <a href="/alerts/" class="navbar-link" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">alerts</a>
            <a href="/whales/" class="navbar-link" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">whales</a>
            <a href="/arbitrage/" class="navbar-link" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">arbitrage</a>
            <a href="/launchpad/" class="navbar-link" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">launchpad</a>
            <a href="/roadmap/" class="navbar-link" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">roadmap</a>
            <a href="/agent/" class="navbar-link active" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">ai trader</a>
        </div>
        <div class="navbar-right">
            <a href="https://x.com/polydictions" target="_blank" class="navbar-social" onmouseover="this.style.transform='perspective(1000px) rotateX(-10deg) rotateY(8deg) translateZ(25px)';this.style.boxShadow='0 8px 30px rgba(0,0,0,0.25),0 0 40px rgba(251,101,30,0.3)'" onmouseout="this.style.transform='perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(15px)';this.style.boxShadow='0 4px 20px rgba(0,0,0,0.15)'" onmousemove="const rect=this.getBoundingClientRect();const x=event.clientX-rect.left;const y=event.clientY-rect.top;const centerX=rect.width/2;const centerY=rect.height/2;const rotateX=((y-centerY)/centerY)*-15;const rotateY=((x-centerX)/centerX)*15;this.style.transform=`perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(25px)`">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                follow on x
            </a>
        </div>
    </nav>

    <!-- Page Content -->
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">ai trader</h1>
            <p class="page-subtitle">ultra-conservative auto-trader for polymarket predictions</p>
        </div>

        <!-- Loading State -->
        <div id="loading" class="loading">
            <div class="spinner"></div>
            <p>loading trader data...</p>
        </div>

        <!-- Inactive State -->
        <div id="inactive-state" class="inactive-state" style="display: none;">
            <h2>trader not started</h2>
            <p>the ai trader hasn't been activated yet. start trading with:</p>
            <code>python simple_trader.py</code>
        </div>

        <!-- Active Trader Content -->
        <div id="active-content" style="display: none;">
            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">capital</div>
                    <div class="stat-value" id="stat-capital">$0.00</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">invested</div>
                    <div class="stat-value" id="stat-invested">$0.00</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">p&l</div>
                    <div class="stat-value" id="stat-pnl">$0.00</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">open positions</div>
                    <div class="stat-value" id="stat-open">0</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">total trades</div>
                    <div class="stat-value" id="stat-total">0</div>
                </div>
            </div>

            <!-- Open Positions -->
            <div class="positions-section">
                <h2 class="section-title">open positions</h2>
                <div class="trades-table">
                    <div id="positions-empty" class="empty-state">no open positions</div>
                    <table id="positions-table" style="display: none;">
                        <thead>
                            <tr>
                                <th>market</th>
                                <th>signal</th>
                                <th>confidence</th>
                                <th>bet size</th>
                                <th>market price</th>
                                <th>opened</th>
                            </tr>
                        </thead>
                        <tbody id="positions-body"></tbody>
                    </table>
                </div>
            </div>

            <!-- Trade History -->
            <div class="history-section">
                <h2 class="section-title">trade history</h2>
                <div class="trades-table">
                    <div id="history-empty" class="empty-state">no trades yet</div>
                    <table id="history-table" style="display: none;">
                        <thead>
                            <tr>
                                <th>market</th>
                                <th>signal</th>
                                <th>confidence</th>
                                <th>bet size</th>
                                <th>status</th>
                                <th>date</th>
                            </tr>
                        </thead>
                        <tbody id="history-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <p>© 2025 polydictions. prediction markets + ai.</p>
    </footer>

    <script>
        const API_BASE = window.location.hostname === 'localhost' ? 'http://localhost:8765' : 'https://api.polydictions.xyz';

        async function loadTraderData() {
            try {
                // Fetch stats
                const statsRes = await fetch(`${API_BASE}/api/trader/stats`);
                const stats = await statsRes.json();

                if (stats.status === 'inactive') {
                    document.getElementById('loading').style.display = 'none';
                    document.getElementById('inactive-state').style.display = 'block';
                    return;
                }

                // Update stats
                document.getElementById('stat-capital').textContent = `$${stats.capital.current.toFixed(2)}`;
                document.getElementById('stat-invested').textContent = `$${stats.capital.invested.toFixed(2)}`;

                const pnl = stats.capital.pnl;
                const pnlEl = document.getElementById('stat-pnl');
                pnlEl.textContent = `${pnl >= 0 ? '+' : ''}$${pnl.toFixed(2)}`;
                pnlEl.className = `stat-value ${pnl >= 0 ? 'green' : 'red'}`;

                document.getElementById('stat-open').textContent = stats.trades.open;
                document.getElementById('stat-total').textContent = stats.trades.total;

                // Fetch positions
                const positionsRes = await fetch(`${API_BASE}/api/trader/positions`);
                const positionsData = await positionsRes.json();

                if (positionsData.positions.length > 0) {
                    document.getElementById('positions-empty').style.display = 'none';
                    document.getElementById('positions-table').style.display = 'table';

                    const tbody = document.getElementById('positions-body');
                    tbody.innerHTML = positionsData.positions.map(p => `
                        <tr>
                            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${p.market_title}</td>
                            <td class="${p.signal === 'YES' ? 'signal-yes' : 'signal-no'}">${p.signal}</td>
                            <td>${p.confidence.toFixed(1)}%</td>
                            <td>$${p.bet_size.toFixed(2)}</td>
                            <td>${(p.market_price * 100).toFixed(1)}%</td>
                            <td>${new Date(p.created_at).toLocaleString()}</td>
                        </tr>
                    `).join('');
                }

                // Fetch history
                const historyRes = await fetch(`${API_BASE}/api/trader/history?limit=20`);
                const historyData = await historyRes.json();

                if (historyData.history.length > 0) {
                    document.getElementById('history-empty').style.display = 'none';
                    document.getElementById('history-table').style.display = 'table';

                    const tbody = document.getElementById('history-body');
                    tbody.innerHTML = historyData.history.map(t => `
                        <tr>
                            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${t.market_title}</td>
                            <td class="${t.signal === 'YES' ? 'signal-yes' : 'signal-no'}">${t.signal}</td>
                            <td>${t.confidence.toFixed(1)}%</td>
                            <td>$${t.bet_size.toFixed(2)}</td>
                            <td><span class="status-${t.status.toLowerCase()}">${t.status}</span></td>
                            <td>${new Date(t.created_at).toLocaleString()}</td>
                        </tr>
                    `).join('');
                }

                // Show active content
                document.getElementById('loading').style.display = 'none';
                document.getElementById('active-content').style.display = 'block';

            } catch (error) {
                console.error('Error loading trader data:', error);
                document.getElementById('loading').innerHTML = '<p style="color: #F87171;">error loading trader data</p>';
            }
        }

        // Load data on page load
        loadTraderData();

        // Auto-refresh every 30 seconds
        setInterval(loadTraderData, 30000);
    </script>
</body>
</html>
